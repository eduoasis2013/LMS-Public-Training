{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "download",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/edu-oasis-lms.html" },
    { "source": "/lms", "destination": "/edu-oasis-lms.html" },
    { "source": "/home", "destination": "/edu-oasis-lms.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/PDPA_Notis_Edu_Oasis.pdf",
      "headers": [{ "key": "Content-Type", "value": "application/pdf" }]
    }
  ]
}
